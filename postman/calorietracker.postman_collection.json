{
  "info": {
    "name": "Calorie Tracker API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "REST API collection for the Calorie Tracker backend. Import alongside calorietracker.postman_environment.json and select the \"Calorie Tracker — Local\" environment. After running Register or Login the accessToken is captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints — registration and login.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.environment.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Alice\"\n}"
            },
            "description": "Create a new user account. Returns a JWT access token and the created user's profile. The accessToken is automatically saved to the environment.\n\nValidation:\n- email: valid email address\n- password: minimum 8 characters\n- displayName: optional"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.environment.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Authenticate with email and password. Returns a JWT access token and the user's profile. The accessToken is automatically saved to the environment."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Foods",
      "description": "Food lookup and user-contributed food creation. All requests require a Bearer token.",
      "item": [
        {
          "name": "Search Foods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/foods/search?q=apple",
              "host": ["{{baseUrl}}"],
              "path": ["foods", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "apple",
                  "description": "Partial name to search for (case-insensitive). Returns up to 50 results."
                }
              ]
            },
            "description": "Search for foods by name across all sources (CIQUAL, OFF, USER). Returns up to 50 results ordered alphabetically. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Get Food by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/foods/1",
              "host": ["{{baseUrl}}"],
              "path": ["foods", "1"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Database ID of the food item"
                }
              ]
            },
            "description": "Retrieve a single food item by its database ID. Returns 404 if not found. Requires authentication."
          },
          "response": []
        },
        {
          "name": "Get Food by Barcode (OFF proxy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/foods/barcode/3017620422003",
              "host": ["{{baseUrl}}"],
              "path": ["foods", "barcode", "3017620422003"],
              "variable": [
                {
                  "key": "ean",
                  "value": "3017620422003",
                  "description": "EAN-13 barcode (e.g. 3017620422003 for Nutella)"
                }
              ]
            },
            "description": "Retrieve a food by EAN barcode. Returns the cached Postgres row on repeated calls; on a cache miss proxies Open Food Facts, persists the result, and returns it. Returns 404 if the barcode is unknown. Requires authentication.\n\n**Attribution:** data sourced from Open Food Facts is licensed under the [Open Database License (ODbL)](https://opendatacommons.org/licenses/odbl/)."
          },
          "response": []
        },
        {
          "name": "Create User Food",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/foods",
              "host": ["{{baseUrl}}"],
              "path": ["foods"]
            },
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"name\": \"Homemade granola bar\",\n  \"brand\": \"Homemade\",\n  \"energyKcal\": 420,\n  \"proteinG\": 8.5,\n  \"carbsG\": 58,\n  \"sugarsG\": 22,\n  \"fatG\": 16,\n  \"satFatG\": 3.2,\n  \"fiberG\": 4.5,\n  \"saltG\": 0.1,\n  \"servingSizeG\": 40\n}"
            },
            "description": "Create a user-contributed food label (source=USER, type=PACKAGED). The food is scoped to the authenticated user. Returns 201 with the created food. Requires authentication."
          },
          "response": []
        }
      ]
    }
  ]
}
